<header class="b5-header b5-header-item">
  <img class="b5-portrait" src="{{item.img}}" data-action="editImage" alt="{{item.name}}">
  <div class="b5-header-main">
    <input class="b5-name" type="text" name="name" value="{{item.name}}">
    <span class="b5-item-type">{{localize (concat "TYPES.Item." item.type)}}</span>
  </div>
</header>
