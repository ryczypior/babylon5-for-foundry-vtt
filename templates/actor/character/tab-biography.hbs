<section class="b5-tab-panel {{#if isActiveTab}}active{{/if}}" data-tab="biography">
  <div class="b5-card">
    <h3>{{localize "B5.Section.details"}}</h3>
    <div class="b5-grid-4">
      <label>{{localize "B5.Field.homeworld"}}
        <input type="text" name="system.details.homeworld" value="{{system.details.homeworld}}">
      </label>
      <label>{{localize "B5.Field.affiliation"}}
        <input type="text" name="system.details.affiliation" value="{{system.details.affiliation}}">
      </label>
      <label>{{localize "B5.Field.age"}}
        <input type="text" name="system.details.age" value="{{system.details.age}}">
      </label>
      <label>{{localize "B5.Field.gender"}}
        <input type="text" name="system.details.gender" value="{{system.details.gender}}">
      </label>
    </div>
  </div>

  <div class="b5-card">
    <h3>{{localize "B5.Section.biography"}}</h3>
    <prose-mirror name="system.details.biography" value="{{source.details.biography}}">
      {{{enriched.biography}}}
    </prose-mirror>
  </div>

  <div class="b5-card">
    <h3>{{localize "B5.Section.notes"}}</h3>
    <prose-mirror name="system.details.notes" value="{{source.details.notes}}">
      {{{enriched.notes}}}
    </prose-mirror>
  </div>
</section>
