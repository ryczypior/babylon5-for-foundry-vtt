{
  "id": "babylon5",
  "title": "Babylon 5 2nd Edition (Unofficial)",
  "description": "Unofficial system for the Babylon 5 Roleplaying Game, 2nd Edition (Mongoose Publishing, d20 System).",
  "version": "0.1.0",
  "authors": [
    {
      "name": "Ryczypior",
      "email": "ryczypior@gmail.com",
      "discord": "Ryczypior"
    }
  ],
  "esmodules": ["module/babylon5.mjs"],
  "styles": ["styles/babylon5.css"],
  "packs": [
    {
      "name": "classes",
      "label": "Classes",
      "path": "packs/classes",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "classes-pl",
      "label": "Klasy (PL)",
      "path": "packs/classes-pl",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "races",
      "label": "Races",
      "path": "packs/races",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "races-pl",
      "label": "Rasy (PL)",
      "path": "packs/races-pl",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "feats",
      "label": "Feats",
      "path": "packs/feats",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "feats-pl",
      "label": "Atuty (PL)",
      "path": "packs/feats-pl",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "equipment",
      "label": "Equipment",
      "path": "packs/equipment",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "equipment-pl",
      "label": "Ekwipunek (PL)",
      "path": "packs/equipment-pl",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "telepathy",
      "label": "Telepathic Abilities",
      "path": "packs/telepathy",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    },
    {
      "name": "telepathy-pl",
      "label": "Zdolności telepatyczne (PL)",
      "path": "packs/telepathy-pl",
      "type": "Item",
      "system": "babylon5",
      "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" }
    }
  ],
  "packFolders": [
    {
      "name": "Babylon 5",
      "sorting": "m",
      "packs": ["classes", "races", "feats", "equipment", "telepathy"],
      "folders": [
        {
          "name": "Polski",
          "sorting": "m",
          "packs": ["classes-pl", "races-pl", "feats-pl", "equipment-pl", "telepathy-pl"]
        }
      ]
    }
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "pl", "name": "Polski", "path": "lang/pl.json" }
  ],
  "documentTypes": {
    "Actor": {
      "character": {},
      "npc": {},
      "craft": {}
    },
    "Item": {
      "class": {},
      "race": {},
      "skill": {},
      "feat": {},
      "influence": {},
      "telepathicAbility": {},
      "weapon": {},
      "armour": {},
      "ammunition": {},
      "gear": {},
      "weaponAccessory": {},
      "craftWeapon": {},
      "craftFeature": {}
    }
  },
  "initiative": "1d20 + @attributes.initiative.total",
  "grid": {
    "distance": 5,
    "units": "ft"
  },
  "primaryTokenAttribute": "attributes.hp",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "socket": false,
  "url": "https://github.com/ryczypior/babylon5-for-foundry-vtt"
}
